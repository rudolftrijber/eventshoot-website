{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/interview-login.ts": {
      "includeFiles": "api/interview/**"
    },
    "api/interview/*.ts": {
      "includeFiles": "api/interview/**"
    },
    "api/interview/**/*.ts": {
      "includeFiles": "api/interview/**"
    }
  },
  "redirects": [
    { "source": "/portfolio", "destination": "/werk", "permanent": true },
    { "source": "/contact", "destination": "/kennismaken", "permanent": true },
    { "source": "/blog", "destination": "/eventkennis", "permanent": true },
    { "source": "/blog/:slug", "destination": "/eventkennis/:slug", "permanent": true },
    { "source": "/hello-world", "destination": "/", "permanent": true },
    { "source": "/hello-world/", "destination": "/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/home/", "destination": "/", "permanent": true },
    { "source": "/faq", "destination": "/eventkennis", "permanent": true },
    { "source": "/faq/", "destination": "/eventkennis", "permanent": true },
    { "source": "/category/:slug/feed", "destination": "/:slug", "permanent": true },
    { "source": "/category/:slug/feed/", "destination": "/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/opt/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/interview-app",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/api/interview-login",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/interview/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
