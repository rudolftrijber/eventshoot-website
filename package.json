    "prebuild": "npm run optimize:images",
    "studio": "npm run dev --prefix studio"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@heroicons/vue": "^2.2.0",
    "@portabletext/vue": "^1.0.14",
    "@sanity/client": "^7.22.0",
    "@sanity/image-url": "^2.1.1",
    "cloudinary": "^2.10.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@vercel/node": "^5.7.16",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "sharp": "^0.34.5",
    "typescript": "~5.7.2",
    "vite": "^6.3.4",
    "vue-tsc": "^2.2.8"
  }
