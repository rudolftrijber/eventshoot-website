{
  "name": "cursor-vue-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "type-check": "vue-tsc --noEmit",
    "seed:faq": "node scripts/seed-faq-kennismaken.mjs",
    "import:faq": "node scripts/import-faq-from-csv.mjs",
