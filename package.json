{
  "name": "cursor-vue-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "dev:vercel": "vercel dev",
    "setup:env": "test -f .env.local || cp .env.example .env.local; echo '→ Bewerk .env.local: INTERVIEW_APP_PASSWORD, INTERVIEW_SESSION_SECRET, POSTGRES_URL (of: vercel env pull .env.local)'",
    "open:env": "open -e .env.local",
    "sync:env": "node scripts/sync-interview-env.mjs",
    "build": "vue-tsc -b && vite build && node scripts/prerender-klanten.mjs && node scripts/prerender-pages.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "type-check": "vue-tsc --noEmit",
    "seed:faq": "node scripts/seed-faq-kennismaken.mjs",
    "seed:interview": "node scripts/seed-interview-demo.mjs",
    "test:interview-csv": "node scripts/test-interview-csv.mjs",
    "test:interview-csv:api": "node scripts/test-interview-csv.mjs --api",
    "import:faq": "node scripts/import-faq-from-csv.mjs",
    "optimize:images": "node scripts/optimize-site-images.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "generate:faq": "node scripts/generate-faq-data.mjs",
    "generate:client-logos": "node scripts/generate-client-logos.mjs",
    "generate:vodcast-photos": "node scripts/generate-vodcast-photos.mjs",
    "prebuild": "npm run optimize:images && npm run generate:sitemap && npm run generate:llms && npm run generate:faq && npm run generate:client-logos && npm run generate:vodcast-photos",
    "studio": "npm run dev --prefix studio"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@heroicons/vue": "^2.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@portabletext/vue": "^1.0.14",
    "@sanity/client": "^7.22.0",
    "@sanity/image-url": "^2.1.1",
    "cloudinary": "^2.10.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@vercel/node": "^5.7.16",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "sharp": "^0.34.5",
    "typescript": "~5.7.2",
    "vite": "^6.3.4",
    "vue-tsc": "^2.2.8"
  }
}
