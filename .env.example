# Cloudinary — https://cloudinary.com (klantenleveringen)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# EmailJS — https://www.emailjs.com
# Service ID en Public Key zijn gedeeld voor alle formulieren.
# Elke formuliersoort krijgt zijn eigen Template ID.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_ID=                 # contactformulier
VITE_EMAILJS_CHECKLIST_TEMPLATE_ID=       # checklist download gate

# Sanity CMS — https://sanity.io/manage
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
# Alleen voor import-scripts (niet in frontend): sanity.io/manage → API → Tokens (Editor)
SANITY_TOKEN=

# Interview App — Neon Postgres via Vercel Storage
# Optioneel lokaal zonder wachtwoord: INTERVIEW_SKIP_AUTH=true (NOOIT op Vercel Production).
# POSTGRES_URL=postgresql://...
# Preferred: one password per crew member (JSON object, names must match exactly):
# INTERVIEW_CREW_PASSWORDS={"Rolf Trijber":"…","Maurice Antenbrink":"…","Ron Gessel":"…","Niels Visser":"…","Vanessa Cristina":"…"}
# Optional legacy shared crew password (fallback while migrating):
# INTERVIEW_APP_PASSWORD=
# INTERVIEW_SESSION_SECRET=
POSTGRES_URL=
INTERVIEW_CREW_PASSWORDS=
INTERVIEW_APP_PASSWORD=
INTERVIEW_SESSION_SECRET=

# Interview App — optional AI question assistant via Claude (server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
